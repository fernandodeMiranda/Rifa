# Bloqueia acesso web direto ao .env, caso a hospedagem exponha
# a raiz do projeto (em vez de apenas a pasta public/).
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
