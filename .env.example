APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rifa
DB_USERNAME=root
DB_PASSWORD=

RESERVA_EXPIRA_MINUTOS=30
UPLOAD_MAX_SIZE_MB=5

# Envio de e-mail (SMTP) — usado no reset de senha.
# Gmail: use uma "senha de app" (não a senha normal da conta), gerada em
# https://myaccount.google.com/apppasswords (exige verificação em 2 etapas ativada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sistema de Rifa
